# locals-only-api: base URL and the shared token secret (same value as the API's API_JWT_SECRET)
API_URL="http://localhost:4000"
API_JWT_SECRET=""

# Optional: address shown to signed-in users who ask to become hosts
HOST_CONTACT_EMAIL=""
