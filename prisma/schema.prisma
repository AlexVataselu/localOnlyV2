datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ActivityType {
  ART_AND_CULTURE
  TOURS
  ENTERTAINMENT
  SIGHTSEEING
  FOOD_AND_DRINK
  WELLNESS
  SPORTS
  NATURE_AND_OUTDOORS
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
}

enum Duration {
  UP_TO_1H
  ONE_TO_4H
  FOUR_H_TO_1_DAY
  ONE_TO_3_DAYS
  THREE_PLUS_DAYS
}

enum Special {
  DEALS_AND_DISCOUNTS
  FREE_CANCELLATION
  SKIP_THE_LINE
  LIKELY_TO_SELL_OUT
  PRIVATE_TOUR
  NEW_EXPERIENCE
}

model Experience {
  id                 String         @id @default(cuid())
  title              String
  location           String
  price              Float
  rating             Float
  image              String
  images             String[]       @default([])
  description        String?
  activityTypes      ActivityType[]
  timeOfDays         TimeOfDay[]
  duration           Duration?
  specials           Special[]
  /// What the price covers, grouped: [{ "title": "Gear", "items": ["E-bike", "Helmet"] }]
  included           Json           @default("[]")
  toBring            String[]       @default([])
  guestRequirements  String[]       @default([])
  cancellationPolicy String?
  languages          String[]       @default([])
  /// "Where you'll be": the route or meeting point, in the host's words.
  whereDescription   String?
  /// Upcoming time slots as shown to guests, e.g. "Sat, 14 Jun · 09:00–13:00".
  availability       String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  userId             String
  host               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews            Review[]
  timeSlots          TimeSlot[]
  bookings           Booking[]
}

/// A bookable date and time for an experience. Remaining places = capacity - confirmed bookings' guests.
model TimeSlot {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int        @default(8)
  /// Price per person for this slot; null means the experience price.
  price        Float?
  bookings     Booking[]
  createdAt    DateTime   @default(now())

  @@unique([experienceId, startsAt])
  @@index([experienceId, startsAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// A guest's booking of a time slot. Prices are copied in so later price changes don't rewrite history.
model Booking {
  id           String        @id @default(cuid())
  /// Short code shown to the guest, e.g. "LO-7K2M9Q".
  reference    String        @unique
  slotId       String
  slot         TimeSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  /// Set when the guest was signed in; guests can also book with name and email only.
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName    String
  guestEmail   String
  guests       Int
  unitPrice    Float
  totalPrice   Float
  status       BookingStatus @default(CONFIRMED)
  createdAt    DateTime      @default(now())

  @@index([slotId])
  @@index([userId])
  @@index([experienceId])
}

/// A guest's review of an experience. Experience.rating is kept as their average.
model Review {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  authorName   String
  rating       Int
  text         String
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}

enum Role {
  CLIENT
  HOST
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(CLIENT)
  /// Shown in "Meet your host".
  bio           String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  experiences   Experience[]
  bookings      Booking[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
